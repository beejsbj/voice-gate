# Generate a real client token with: voice-gate init
VG_TOKENS={"personal":"replace-with-at-least-24-random-characters"}
VG_PROVIDER=fixture
# Live choices: typesafe or openrouter. Set the corresponding key.
# TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# VG_JEV_BASE_URL=https://openrouter.ai/api
# VG_JEV_MODEL=typesafe/jev-1.13
# VG_DATABASE=/data/captures.sqlite
# VG_ORIGINS=https://voice.example.com
# Operator-defined targets only. No URL can come from transcript input.
VG_TARGETS=[]
# Example health: [{"id":"assistant-health","name":"Assistant health","kind":"health","url":"http://your-assistant:8642/health"}]
# Example assistant: [{"id":"assistant","name":"My assistant","kind":"openai","url":"http://your-assistant:8642/v1/chat/completions","model":"hermes-agent","token_env":"ASSISTANT_TOKEN"}]
# ASSISTANT_TOKEN=
